# Project
COMPOSE_PROJECT_NAME=heikohardt-bhext-behat-typo3-extension
COMPOSE_PROJECT_ROOT=/var/www/html
COMPOSE_PROJECT_PORT=01

# System User
USER_NAME="${CMD_DOCKER_USER_NAME}"
USER_ID="${CMD_DOCKER_USER_ID}"
GROUP_NAME="${CMD_DOCKER_GROUP_NAME}"
GROUP_ID="${CMD_DOCKER_GROUP_ID}"

# Apache
APACHE_PORT="8080"
APACHE_PORT_SSL="8443"
APACHE_DOCUMENT_ROOT="/var/www/html/.public-tests"
APACHE_SERVER_NAME="localhost"
APACHE_SERVER_ALIAS="127.0.0.1 web"

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=application
DB_USER=developer
DB_PASSWORD=P@ssw0rd

# PHP
XDEBUG_CONFIG=client_host=host.docker.internal
XDEBUG_MODE=coverage,debug,develop

# TYPO3
# TYPO3_BRANCH="9.5" (deprecated in composer 2.x setup)
ORIGIN_PATH_ROOT="${COMPOSE_PROJECT_ROOT}"
TYPO3_CONTEXT="Development/Docker"
TYPO3_PATH_ROOT="${COMPOSE_PROJECT_ROOT}/.public-tests"
TYPO3_PATH_APP="${COMPOSE_PROJECT_ROOT}/.public-tests"

TESTING_URL="http://localhost:80${COMPOSE_PROJECT_PORT}"
TESTING_PATH_ROOT="${COMPOSE_PROJECT_ROOT}/.public-tests"
TESTING_DB_HOST="${DB_HOST}"
TESTING_DB_PORT="${DB_PORT}"
TESTING_DB_NAME="${DB_DATABASE}"
TESTING_DB_USER="${DB_USER}"
TESTING_DB_PASSWORD="${DB_PASSWORD}"
